# Ubuntu SQL Server Environment Variables
#
# Copy this file to .env and replace the example values
# with the correct values for your environment.

# PostgreSQL

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ubuntu_sql_server
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Notifications

NTFY_TOPIC=your_ntfy_topic
