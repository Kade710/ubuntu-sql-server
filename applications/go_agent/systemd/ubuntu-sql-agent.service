[Unit]
Description=Ubuntu SQL Server Go Agent
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=jonathon
WorkingDirectory=/home/jonathon/Projects/ubuntu-sql-server/applications/go_agent
EnvironmentFile=/home/jonathon/Projects/ubuntu-sql-server/applications/go_agent/.env
ExecStart=/home/jonathon/Projects/ubuntu-sql-server/applications/go_agent/agent --refresh

[Install]
WantedBy=multi-user.target